double distnace(double x1,double y1,double x2,double y2) {
    return sqrt((x2-x1)*(x2-x1) + (y2-y1)*(y2-y1));
}
double bruteforce(int l,int r,vector<vector<double>>& points) {
    double d = INT_MAX;
    for (int i = l ;i<r;i++) {
        for (int j = i+1;j<=r;j++) {
            d = min(d,distnace(points[i][0],points[i][1],points[j][0],points[j][1]));
        }
    }
    return d;
}
double stripClosest(int l,int r,vector<vector<double>>& strip) {
    double d = INT_MAX;
    for (int i = l ;i<r;i++) {
        for (int j = i+1;j<=r && (abs(strip[i][1] - strip[j][1]) < d);j++) {
            d = min(d,distnace(strip[i][0],strip[i][1],strip[j][0],strip[j][1]));
        }
    }
    return d;
}
double divide(int l,int r,vector<vector<double>>& points) {
    if (r - l < 3) {
        return bruteforce(l,r,points);
    }
    int m = (l+r)/2;
    double dl = divide(l,m,points);
    double dr = divide(m+1,r,points);
    double d = min(dl,dr);
    double mid = points[m][0];
    vector<vector<double>> strip;
    for (int i=l;i<=r;i++) {
        if (abs(mid - points[i][0]) < d) {
            strip.push_back(points[i]);
        }
    }
    sort(strip.begin(),strip.end(), [](auto &a, auto &b){return a[1] < b[1];});
    if (strip.size() > 1) {
        d = min(d,stripClosest(0,strip.size()-1,strip));
    }
    return d;

 }
double minDistance(vector<vector<double>>& points) {
    sort(points.begin(),points.end(),[](auto &a, auto &b) {
        return a[0] < b[0];
    });
    return divide(0,points.size()-1,points);
}
int main() {
    int n;
    cin>>n;
    vector<vector<double>> points(n,vector<double>(2));
    for (int i=0;i<n;i++) {
        cin>>points[i][0] >> points[i][1];
    }
    cout<<minDistance(points);
    return 0;
}
