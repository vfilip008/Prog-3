#include <iostream>
#include <climits>
#include <vector>
using namespace std;
int main()
{
    int target = 226;
    vector<int> arr = {1,3,11,21};
    vector<int> dp(target+1,INT_MAX);
    for(int i=0;i<arr.size();i++){
        dp[arr[i]] = 1;
    }
    dp[0]= 0;
    for (int i=1;i<=target;i++) {
        for (int j=0;j<arr.size();j++) {
            if (i-arr[j]>=0) {
                dp[i] = min(dp[i], dp[i-arr[j]]+1);
            }
        }
    }
    cout<<dp[12]<<endl;
    cout<<dp[124]<<endl;
    cout<<dp[226]<<endl;
    return 0;
}
